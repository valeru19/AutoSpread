DEBUG=false
DATABASE_URL=postgresql+asyncpg://autospread:autospread@localhost:5432/autospread
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# Retention (cleanup jobs later; not schema). Audited defaults:
# ads — market snapshots: 90d (marketplace/catalog request history window, e.g. AWS Marketplace 90d;
#       order-book examples often 30d — берём 90d для разбора споров по цене)
# receipts — payment proofs: 1825d = 5y (AML/fintech baseline: UK HMRC Reg.40, CBUAE, FinCEN/MSB)
ADS_TTL_DAYS=90
RECEIPT_TTL_DAYS=1825

# Windows: if local postgresql-x64-16 owns :5432, use docker-compose.override.yml (:5433)
# DATABASE_URL=postgresql+asyncpg://autospread:autospread@127.0.0.1:5433/autospread
